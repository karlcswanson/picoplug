# Usage: cmake -DIN=<file> -DOUT=<header> -DNAME=<symbol> -P bin2c.cmake
# Emits: const unsigned char NAME[] = {...}; const unsigned NAME_len = N;
file(READ "${IN}" HEX_CONTENT HEX)
string(LENGTH "${HEX_CONTENT}" HEX_LEN)
math(EXPR BYTE_LEN "${HEX_LEN} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ARRAY "${HEX_CONTENT}")
# wrap lines every 16 bytes for readability
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n" ARRAY "${ARRAY}")
file(WRITE "${OUT}"
"/* Generated by bin2c.cmake from ${IN}. Do not edit. */
#ifndef ${NAME}_H
#define ${NAME}_H
static const unsigned char ${NAME}[] = {
${ARRAY}
};
static const unsigned ${NAME}_len = ${BYTE_LEN};
#endif
")
